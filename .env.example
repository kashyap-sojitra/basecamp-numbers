# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values you want.
#   cp .env.example .env.local
# .env.local is gitignored. Both the app and the db:* scripts read it.
# ---------------------------------------------------------------------------

# REQUIRED — Neon Postgres connection string.
# Without it the app builds and onboarding renders, but nothing saves: the API
# answers 503 and says so. Create a free database at https://neon.tech, copy
# the pooled connection string, then run `npm run db:migrate`.
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# OPTIONAL — Gemini API key, free tier is fine: https://aistudio.google.com/apikey
# Used only for word-problem wording and encouragement lines; never for any
# arithmetic. Without it (or if a call fails, times out or is rate-limited)
# those words come from the local template bank and the app is fully playable.
GEMINI_API_KEY=""

# OPTIONAL — override the model. Defaults to gemini-3.6-flash.
# Note the free tier allows ~5 calls/minute per model, so most word problems
# will come from the local template bank regardless. A paid key lifts this.
# GEMINI_MODEL="gemini-3.6-flash"

# OPTIONAL — calls per minute the app will spend. Defaults to 4, just under
# the free tier's 5. Raise it if your key has a higher quota.
# GEMINI_MAX_CALLS_PER_MINUTE="4"
